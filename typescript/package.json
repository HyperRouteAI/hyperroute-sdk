{
  "name": "@hyperroute/sdk",
  "version": "0.1.0",
  "description": "TypeScript and JavaScript client for HyperRoute",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://hyperroute.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyperRouteAI/hyperroute-sdk.git",
    "directory": "typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0"
  }
}
